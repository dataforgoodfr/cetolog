Deleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Un réseau de neurones\n(EfficientNetV2-M) issu de la\nsolution gagnante de Kaggle\nHappywhale.\n\nOn l'utilise tel quel, sans le\nréentraîner.\n\nIl ne dit jamais « c'est TUTR0025 » :\nil produit seulement des nombres.", "originalText": "Un réseau de neurones\n(EfficientNetV2-M) issu de la\nsolution gagnante de Kaggle\nHappywhale.\n\nOn l'utilise tel quel, sans le\nréentraîner.\n\nIl ne dit jamais « c'est TUTR0025 » :\nil produit seulement des nombres.", "fontSize": 25, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "de21", "type": "rectangle", "x": 2580, "y": 920, "width": 1160, "height": 601.4514285714286, "angle": 0, "strokeColor": "#212529", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2037, "version": 1, "versionNonce": 2751, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "de22", "type": "rectangle", "x": 2580, "y": 920, "width": 1160, "height": 76, "angle": 0, "strokeColor": "#212529", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2134, "version": 1, "versionNonce": 2882, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "de23", "type": "text", "x": 2608, "y": 940, "width": 1104, "height": 38, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2231, "version": 1, "versionNonce": 3013, "isDeleted": false, "boundElements": null, "updat