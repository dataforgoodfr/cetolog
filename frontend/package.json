{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.2"
